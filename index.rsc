19:["$","section",null,{"className":"band how","id":"how","children":[["$","div",null,{"className":"sectionHead","children":[["$","div",null,{"data-reveal":true,"children":[["$","span",null,{"className":"pill","children":"How I work"}],["$","h2",null,{"className":"fill","children":["From Fuzzy",["$","br",null,{}],"to Shipped"]}]]}],["$","p",null,{"data-lines":true,"children":"Same rigour at every size. The only difference is how much of the problem is already known when I start."}]]}],["$","div",null,{"className":"planGrid","data-reveal":true,"children":[["$","article","Discover",{"children":[["$","div",null,{"className":"planHead","children":[["$","span",null,{"className":"capIcon","aria-hidden":"true","children":"◍"}],["$","h3",null,{"children":"Discover"}]]}],["$","p",null,{"className":"planPrice","children":"Weeks 1–2"}],["$","p",null,{"children":"Before scope, before tickets. Talk to the people living the problem and find out which parts of it are actually worth solving."}],["$","ul",null,{"children":[["$","li","User and stakeholder interviews",{"children":"User and stakeholder interviews"}],["$","li","Market and competitor investigation",{"children":"Market and competitor investigation"}],["$","li","Assumption and risk mapping",{"children":"Assumption and risk mapping"}],["$","li","Problem statement everyone agrees on",{"children":"Problem statement everyone agrees on"}]]}],["$","p",null,{"className":"planNote","children":"For problems that are still fuzzy and need a shape before anyone commits."}]]}],["$","article","Define",{"children":[["$","div",null,{"className":"planHead","children":[["$","span",null,{"className":"capIcon","aria-hidden":"true","children":"▚"}],["$","h3",null,{"children":"Define"}]]}],["$","p",null,{"className":"planPrice","children":"Weeks 2–4"}],["$","p",null,{"children":"Turn what I heard into something a team can build against: scoped, sequenced, and honest about what is being left out."}],["$","ul",null,{"children":[["$","li","Requirements and acceptance criteria",{"children":"Requirements and acceptance criteria"}],["$","li","Success metrics and instrumentation plan",{"children":"Success metrics and instrumentation plan"}],["$","li","MVP cut with an explicit not-now list",{"children":"MVP cut with an explicit not-now list"}],["$","li","Prototype to pressure-test the flow",{"children":"Prototype to pressure-test the flow"}]]}],["$","p",null,{"className":"planNote","children":"For teams that have signal but no shared definition of done."}]]}],["$","article","Deliver",{"children":[["$","div",null,{"className":"planHead","children":[["$","span",null,{"className":"capIcon","aria-hidden":"true","children":"✦"}],["$","h3",null,{"children":"Deliver"}]]}],["$","p",null,{"className":"planPrice","children":"Ongoing"}],["$","p",null,{"children":"Keep priorities, owners, and risks visible until it ships — then read what the data says and feed it back into the next cut."}],["$","ul",null,{"children":[["$","li","Backlog grooming and sprint planning",{"children":"Backlog grooming and sprint planning"}],["$","li","Cross-functional coordination in Jira",{"children":"Cross-functional coordination in Jira"}],["$","li","Risk and dependency tracking",{"children":"Risk and dependency tracking"}],["$","li","Post-launch analytics and iteration",{"children":"Post-launch analytics and iteration"}]]}],["$","p",null,{"className":"planNote","children":"For delivery that has to survive contact with real clients and real deadlines."}]]}]]}]]}]
1a:["$","section",null,{"className":"cta","children":[["$","h2",null,{"data-lines":true,"children":["Turn Your Idea",["$","br",null,{}],"Into a ",["$","span",null,{"children":"Decision"}]]}],["$","p",null,{"data-lines":"fast","children":"Every product has a next step hiding behind an unanswered question. I am good at finding which question that is."}],["$","div",null,{"className":"bubble","data-reveal":true,"data-d":"2","children":[["$","b",null,{"children":"UT"}],["$","div",null,{"children":[["$","span",null,{"className":"typing","aria-hidden":"true","children":[["$","i",null,{}],["$","i",null,{}],["$","i",null,{}]]}],["$","p",null,{"children":"Have something in mind?"}],["$","a",null,{"className":"btn mag","href":"mailto:contact.utkarshtiwari@gmail.com","children":"Let's Talk"}]]}]]}]]}]
1b:["$","section",null,{"className":"notes","id":"notes","children":[["$","div",null,{"className":"sectionHead","children":[["$","div",null,{"data-reveal":true,"children":[["$","span",null,{"className":"pill","children":"Principles"}],["$","h2",null,{"className":"fill","children":["What the Work",["$","br",null,{}],"Taught Me"]}]]}],["$","p",null,{"data-lines":true,"children":"Not theory. Five things I got wrong first, then corrected — each one tied to a project where it actually cost something."}]]}],["$","div",null,{"children":[["$","div",null,{"className":"notesScroll dragRail","children":[["$","article","Talk to supply before you build demand.",{"className":"noteCard","data-reveal":true,"data-d":1,"children":[["$","div",null,{"className":"noteTop","children":[["$","h3",null,{"children":"Talk to supply before you build demand."}],["$","span",null,{"className":"noteQuote","aria-hidden":"true","children":"”"}]]}],["$","p",null,{"children":"It is tempting to design the polished side of a marketplace first. The 45+ owner conversations behind BenNest changed the product more than any wireframe did — half the features I assumed were essential never made the cut."}],["$","div",null,{"className":"noteFoot","children":[["$","b",null,{"children":"BN"}],["$","span",null,{"children":[["$","strong",null,{"children":"BenNest"}],"45+ owner conversations"]}]]}]]}],["$","article","A tracking bug is a business problem.",{"className":"noteCard","data-reveal":true,"data-d":2,"children":[["$","div",null,{"className":"noteTop","children":[["$","h3",null,{"children":"A tracking bug is a business problem."}],["$","span",null,{"className":"noteQuote","aria-hidden":"true","children":"”"}]]}],["$","p",null,{"children":"Broken instrumentation does not show up as an error. It shows up as a confident decision made on numbers that were never real. Auditing what is measured is part of the analysis, not a chore before it."}],["$","div",null,{"className":"noteFoot","children":[["$","b",null,{"children":"GA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Analytics work"}],"Marketing & web traffic"]}]]}]]}],["$","article","Visible ownership beats a longer status update.",{"className":"noteCard","data-reveal":true,"data-d":3,"children":[["$","div",null,{"className":"noteTop","children":[["$","h3",null,{"children":"Visible ownership beats a longer status update."}],["$","span",null,{"className":"noteQuote","aria-hidden":"true","children":"”"}]]}],["$","p",null,{"children":"Across 15+ client projects spanning technical, 3D rendering, and sales teams, almost nothing was blocked by a lack of effort. It was blocked by nobody knowing whose turn it was. Naming the owner fixed more than escalating did."}],["$","div",null,{"className":"noteFoot","children":[["$","b",null,{"children":"CV"}],["$","span",null,{"children":[["$","strong",null,{"children":"Convrse Solutions"}],"15+ client projects"]}]]}]]}],["$","article","Prototype until the argument ends.",{"className":"noteCard","data-reveal":true,"data-d":4,"children":[["$","div",null,{"className":"noteTop","children":[["$","h3",null,{"children":"Prototype until the argument ends."}],["$","span",null,{"className":"noteQuote","aria-hidden":"true","children":"”"}]]}],["$","p",null,{"children":"Debating an idea in a doc is cheap but slow. Building the thin version of it is slightly more expensive and settles the question. ProdIntel AI exists because a ranked recommendation was easier to judge than to describe."}],["$","div",null,{"className":"noteFoot","children":[["$","b",null,{"children":"PI"}],["$","span",null,{"children":[["$","strong",null,{"children":"ProdIntel AI"}],"569 deterministic tests"]}]]}]]}],["$","article","Say what you decided not to do.",{"className":"noteCard","data-reveal":true,"data-d":4,"children":[["$","div",null,{"className":"noteTop","children":[["$","h3",null,{"children":"Say what you decided not to do."}],["$","span",null,{"className":"noteQuote","aria-hidden":"true","children":"”"}]]}],["$","p",null,{"children":"A requirements doc that only lists what is in scope is half a document. The not-now list is what stops a team from quietly rebuilding the thing you already ruled out three sprints ago."}],["$","div",null,{"className":"noteFoot","children":[["$","b",null,{"children":"PM"}],["$","span",null,{"children":["$L27","Applies everywhere"]}]]}]]}]]}],"$L28"]}]]}]
1c:["$","section",null,{"className":"band faq","id":"faq","children":[["$","div",null,{"className":"sectionHead","data-reveal":true,"children":["$","div",null,{"children":[["$","span",null,{"className":"pill","children":"FAQ"}],["$","h2",null,{"className":"fill","children":["Got any",["$","br",null,{}],"questions?"]}]]}]}],["$","div",null,{"className":"faqGrid","data-reveal":true,"data-d":"1","children":[["$","details","Why product management?",{"children":[["$","summary",null,{"children":"Why product management?"}],["$","p",null,{"children":"Because the work I keep gravitating toward — framing the problem, talking to users, deciding what not to build, keeping delivery honest — turns out to be the job. The technical side makes me a better partner to engineers; it is not the part I want to optimise for."}]]}],["$","details","Do you actually write code?",{"children":[["$","summary",null,{"children":"Do you actually write code?"}],["$","p",null,{"children":"Yes, enough to be useful and not enough to be precious about it. FastAPI, Next.js, SQL, Python, Git. I prototype to settle arguments and to understand what I am asking engineers for — not to own the codebase."}]]}],["$","details","What does your discovery process look like?",{"children":[["$","summary",null,{"children":"What does your discovery process look like?"}],["$","p",null,{"children":"Interviews first, and with the side of the market that usually gets skipped. For BenNest that meant 45+ property owner conversations before any requirement was written. I map assumptions, mark the risky ones, and go test those."}]]}],["$","details","How do you handle ambiguity?",{"children":[["$","summary",null,{"children":"How do you handle ambiguity?"}],["$","p",null,{"children":"Narrow it until a decision is possible. That usually means separating what we know from what we are assuming, picking the one assumption that would hurt most if wrong, and finding the cheapest way to check it this week."}]]}],["$","details","What tools do you work in?",{"children":[["$","summary",null,{"children":"What tools do you work in?"}],["$","p",null,{"children":"Jira for delivery, SQL and Python for analysis, GA-style web analytics for funnels and engagement, Figma for flows, and whatever the team already lives in. The tool matters far less than whether priorities and owners are visible in it."}]]}],["$","details","How do you measure success?",{"children":[["$","summary",null,{"children":"How do you measure success?"}],["$","p",null,{"children":"By what changed for the user and the business, not by tickets closed. That means agreeing on the metric and the instrumentation before launch, so the post-launch conversation is about evidence rather than opinion."}]]}],["$","details","Are you available for internships or PM roles?",{"children":[["$","summary",null,{"children":"Are you available for internships or PM roles?"}],["$","p",null,{"children":"Yes — I am class of 2027 and open to product internships, associate PM roles, and project work now. Fastest way to start is email; I will reply with context on what I have shipped and where I would fit."}]]}],["$","details","What are you working on next?",{"children":[["$","summary",null,{"children":"What are you working on next?"}],["$","p",null,{"children":"Going deeper on product analytics and on AI-assisted decision systems — ProdIntel AI is where most of that thinking currently lives. Alongside that, more discovery reps, because that is the muscle that compounds."}]]}]]}]]}]
