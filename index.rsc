1e:["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n(function(){\nfunction start(){\nvar root = document.documentElement;\nvar bar = document.querySelector('.preBar'), num = document.querySelector('.preNum');\nfunction done(){\n  if (root.classList.contains('ready')) return;\n  root.classList.add('ready');\n  // Motion holds the hero timeline paused until this fires\n  dispatchEvent(new Event('ut:ready'));\n}\nif (matchMedia('(prefers-reduced-motion: reduce)').matches) { done(); return; }\n// rAF, not setInterval: background tabs throttle timers to ~1Hz, which\n// stretched a 0.5s intro into a 10s one\nvar t0 = performance.now(), DUR = 850;\n(function tick(now){\n  var p = Math.min(1, (now - t0) / DUR);\n  var n = Math.round(p * 100);\n  if (bar) bar.style.width = n + '%';\n  if (num) num.textContent = String(n).padStart(3, '0');\n  if (p < 1) requestAnimationFrame(tick); else setTimeout(done, 180);\n})(t0);\nsetTimeout(done, 2600); // safety net; done() is idempotent\n}\nif (document.readyState === 'loading') addEventListener('DOMContentLoaded', start);\nelse start();\n})();\n"}}]
